# CyberArena Environment Configuration
# Copy this file to .env in your backend or project root

# Host & Port configuration
CYBERARENA_HOST=127.0.0.1
CYBERARENA_PORT=8000
CYBERARENA_ENV=development

# VM Registry Config Path (defaults to configs/vms.json relative to project root)
CYBERARENA_CONFIG_PATH=configs/vms.json

# Maximum VMs permitted (overrides vms.json if set, dynamic integer)
# CYBERARENA_MAX_VM=2

# Path to VirtualBox VBoxManage executable (auto-detected if omitted)
# VBOX_MANAGE_PATH="C:\Program Files\Oracle\VirtualBox\VBoxManage.exe"

# Lab VM Credentials (never check actual credentials into git)
CYBERARENA_VM01_PASSWORD=cyberarena_lab_pass
CYBERARENA_VM02_PASSWORD=cyberarena_lab_pass

# Optional SSH Key Paths
# CYBERARENA_VM01_KEY_PATH="C:\Users\Shivam\.ssh\cyberarena_vm01_id_rsa"
# CYBERARENA_VM02_KEY_PATH="C:\Users\Shivam\.ssh\cyberarena_vm02_id_rsa"

# Default Command Execution Timeout (seconds)
CYBERARENA_DEFAULT_SSH_TIMEOUT=30
