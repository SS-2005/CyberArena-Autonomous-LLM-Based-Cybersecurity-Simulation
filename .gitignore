# ==============================================================================
# CyberArena .gitignore
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Virtualization / Disk Images / Large Binaries (CRITICAL for GitHub limits)
*.iso
*.img
*.qcow2
*.vdi
*.vmdk
*.vhd
*.vhdx
*.box
*.ova
*.ovf
*.sav
*.nvram

# Local Databases & Runtime Storage
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
cyberarena.db
data/
scratch/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables, credentials, and secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.id_rsa
id_rsa
id_ecdsa
id_ed25519

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Node / Frontend Dependencies & Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Testing, Coverage & Profiling
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Application Runtime Logs
*.log
logs/
backend/logs/
